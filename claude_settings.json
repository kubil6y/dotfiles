{
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "notify-send -i dialog-information 'Claude Code' 'Done' & paplay --volume=40000 /usr/share/sounds/freedesktop/stereo/message.oga & # volume: 0-65536"
                    }
                ]
            }
        ],
        "Notification": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "notify-send -i dialog-information 'Claude Code' 'Needs your input' & paplay --volume=40000 /usr/share/sounds/freedesktop/stereo/message.oga & # volume: 0-65536"
                    }
                ]
            }
        ]
    }
}
